{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "jsx": "react-jsx",
    // `globals: true` in vitest.config.ts puts describe/it/expect in scope
    // without an import; without this they are unresolved identifiers.
    "types": ["node", "vitest/globals"],
    // Workspace packages are consumed as *source*, not as build output. Metro
    // and Vite each compile them themselves, so there is no build step to keep
    // in sync and no stale `dist/` to accidentally ship.
    "paths": {
      "@openclaw/protocol": ["./packages/protocol/src/index.ts"],
      "@openclaw/gateway-client": ["./packages/gateway-client/src/index.ts"],
      "@openclaw/conversation": ["./packages/conversation/src/index.ts"],
      "@openclaw/notifier": ["./packages/notifier/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "sidecar/**/*",
    "tests/**/*",
    "packages/*/src/**/*",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "release", "shell", "reports", "apps"]
}
