{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "jsx": "react-jsx",
    // `globals: true` in vitest.config.ts puts describe/it/expect in scope
    // without an import; without this they are unresolved identifiers.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "sidecar/**/*", "tests/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "release", "shell", "reports"]
}
