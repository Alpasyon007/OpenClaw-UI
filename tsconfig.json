{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "sidecar/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "release", "shell"]
}
