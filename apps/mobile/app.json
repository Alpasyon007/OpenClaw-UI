{
  "expo": {
    "name": "OpenClaw Companion",
    "slug": "openclaw-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openclaw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dev.openclaw.companion",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "dev.openclaw.companion",
      "supportsTablet": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
