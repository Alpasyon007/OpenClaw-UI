{
  "name": "openclaw-ui",
  "version": "0.1.0",
  "description": "OpenClaw UI — Desktop Interface for OpenClaw CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuhammadDaudNasir/OpenClaw-UI.git"
  },
  "bugs": {
    "url": "https://github.com/MuhammadDaudNasir/OpenClaw-UI/issues"
  },
  "homepage": "https://github.com/MuhammadDaudNasir/OpenClaw-UI#readme",
  "scripts": {
    "bootstrap": "bash ./commands/bootstrap.command",
    "deploy": "bash ./commands/deploy.command",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "shim": "node sidecar/gen-shim.mjs src/shared/clui-contract.ts src/shared/types.ts shell/web/clui-shim.js",
    "sidecar": "esbuild sidecar/index.ts --bundle --platform=node --format=cjs --target=node22 --external:node-pty --minify --outfile=shell/sidecar/main.cjs",
    "dist": "node build-release.mjs",
    "dist:web": "node build-release.mjs --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "check:generated": "node scripts/check-generated.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:generated && npm run test",
    "doctor": "bash scripts/doctor.sh",
    "setup:git": "bash ./commands/setup-git.command"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.35.1",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "zustand": "^5.0.0"
  }
}
